# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API. Defaults to 1 in production (Render), off locally.
# TRUST_PROXY=1

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/sportsphere
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sportsphere
MONGODB_URI=mongodb://127.0.0.1:27017/sportsphere

# ---- GNews (https://gnews.io — free key: 100 requests/day, 10 articles/request) ----
GNEWS_API_KEY=your_gnews_api_key_here
GNEWS_LANG=en
# Optional 2-letter country code, e.g. in, us, gb. Leave empty for worldwide.
GNEWS_COUNTRY=
# Lower this to 10 on the free plan; raise it on paid plans (max 100)
GNEWS_MAX_PER_REQUEST=10

# ---- Caching / limits ----
# How long GNews responses are cached in memory and treated as "fresh" in MongoDB
CACHE_TTL_SECONDS=3600
# Requests per minute per IP before the API answers 429
RATE_LIMIT_PER_MIN=120
# Category sections shown on the homepage (each costs up to 1 GNews call per cache window)
HOME_SECTIONS=cricket,football,basketball,tennis
# Set true to restrict search to sports-related wording (may reduce result counts)
SEARCH_SPORTS_ONLY=false
